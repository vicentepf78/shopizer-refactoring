        "path": "/api/v1/content/boxes/sidebar",
        "query": {
          "lang": [
            "en"
          ],
          "store": [
            "DEFAULT"
          ]
        }
      },
      "response": {
        "body": {
          "code": "sidebar",
          "contentType": "BOX",
          "id": 2
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.code": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
