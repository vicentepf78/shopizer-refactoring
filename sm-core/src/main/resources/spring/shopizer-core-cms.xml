<beans:beans xmlns:beans="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.springframework.org/schema/data/jpa"
  xmlns:util="http://www.springframework.org/schema/util"
  xmlns:context="http://www.springframework.org/schema/context"
  xmlns:aop="http://www.springframework.org/schema/aop"
  xmlns:tx="http://www.springframework.org/schema/tx"
  xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/tx 
    http://www.springframework.org/schema/tx/spring-tx.xsd
    http://www.springframework.org/schema/aop 
    http://www.springframework.org/schema/aop/spring-aop.xsd
    http://www.springframework.org/schema/util
    http://www.springframework.org/schema/util/spring-util.xsd
    http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context.xsd
    http://www.springframework.org/schema/data/jpa
    http://www.springframework.org/schema/data/jpa/spring-jpa.xsd">

  <!-- Product CMS only (ADR-008): contentFileManager + content backends live in shopizer-content-cms.xml -->

  <beans:bean id="productFileManager"
    class="com.salesmanager.core.business.modules.cms.product.ProductFileManagerImpl">
    <beans:property name="uploadImage">
      <beans:ref bean="${config.cms.method}ProductAssetsManager" />
    </beans:property>
    <beans:property name="getImage">
      <beans:ref bean="${config.cms.method}ProductAssetsManager" />
    </beans:property>
    <beans:property name="removeImage">
      <beans:ref bean="${config.cms.method}ProductAssetsManager" />
    </beans:property>
    <beans:property name="configuration">
      <beans:ref bean="coreConfiguration" />
    </beans:property>
  </beans:bean>

  <beans:bean id="productDownloadsFileManager"
    class="com.salesmanager.core.business.modules.cms.content.StaticContentFileManagerImpl">
    <beans:property name="uploadFile">
      <beans:ref bean="${config.cms.method}DownloadsManager" />
    </beans:property>
    <beans:property name="getFile">
      <beans:ref bean="${config.cms.method}DownloadsManager" />
    </beans:property>
    <beans:property name="removeFile">
      <beans:ref bean="${config.cms.method}DownloadsManager" />
    </beans:property>
  </beans:bean>

  <beans:bean id="defaultProductAssetsManager"
    class="com.salesmanager.core.business.modules.cms.product.infinispan.CmsImageFileManagerImpl"
    factory-method="getInstance">
    <beans:property name="cacheManager">
      <beans:ref bean="infinispanProductAssetsManager" />
    </beans:property>
  </beans:bean>

  <beans:bean id="httpdProductAssetsManager"
    class="com.salesmanager.core.business.modules.cms.product.local.CmsImageFileManagerImpl"
    factory-method="getInstance">
    <beans:property name="cacheManager">
      <beans:ref bean="httpdAssetsManager" />
    </beans:property>
  </beans:bean>

  <beans:bean id="awsProductAssetsManager"
    class="com.salesmanager.core.business.modules.cms.product.aws.S3ProductContentFileManager"
    factory-method="getInstance">
    <beans:property name="cmsManager">
      <beans:ref bean="awsAssetsManager" />
    </beans:property>
  </beans:bean>

  <beans:bean id="defaultDownloadsManager"
    class="com.salesmanager.core.business.modules.cms.content.infinispan.CmsStaticContentFileManagerImpl"
    factory-method="getInstance">
    <beans:property name="cacheManager">
      <beans:ref bean="downloadsManager" />
    </beans:property>
  </beans:bean>

  <beans:bean id="httpdDownloadsManager"
    class="com.salesmanager.core.business.modules.cms.content.local.CmsStaticContentFileManagerImpl"
    factory-method="getInstance">
    <beans:property name="cacheManager">
      <beans:ref bean="httpdAssetsManager" />
    </beans:property>
  </beans:bean>

  <beans:bean id="awsDownloadsManager"
    class="com.salesmanager.core.business.modules.cms.content.aws.S3StaticContentAssetsManagerImpl"
    factory-method="getInstance">
    <beans:property name="cmsManager">
      <beans:ref bean="awsAssetsManager" />
    </beans:property>
  </beans:bean>

  <beans:bean id="infinispanProductAssetsManager"
    class="com.salesmanager.core.business.modules.cms.impl.StoreCacheManagerImpl">
    <beans:constructor-arg value="${config.cms.store.location}" />
    <beans:constructor-arg value="product-merchant" />
  </beans:bean>

  <beans:bean id="downloadsManager"
    class="com.salesmanager.core.business.modules.cms.impl.DownloadCacheManagerImpl">
    <beans:constructor-arg value="${config.cms.store.location}" />
    <beans:constructor-arg value="product-file" />
  </beans:bean>

  <!-- GCP: gcpProductAssetsManager via @Component scan (ADR-008) -->

</beans:beans>
